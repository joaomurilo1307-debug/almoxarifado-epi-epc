generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Usuario simples de login (sem os niveis/hierarquia do consominas-gestao —
// este e um sistema a parte, feito pra depois ser incorporado ao sistema de
// chamados; login aqui e so pra nao deixar a tela de estoque aberta pra
// qualquer um enquanto isso nao acontece).
model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  epiMovimentacoesRegistradas EpiMovimentacao[]
}

enum EpiTipo {
  EPI
  EPC
  FARDAMENTO
  GERAL
}

enum EpiMovimentoTipo {
  ENTRADA
  SAIDA
}

model EpiContrato {
  id                     String   @id @default(cuid())
  codigo                 String   @unique
  nome                   String?
  ativo                  Boolean  @default(true)
  percentualContingencia Float    @default(0.10)
  createdAt              DateTime @default(now())

  colaboradores EpiColaborador[]
  movimentacoes EpiMovimentacao[]
  estoques      EpiEstoque[]
  funcaoRegras  EpiFuncaoRegra[]
}

model EpiColaborador {
  id            String    @id @default(cuid())
  nomeCompleto  String
  contratoId    String
  funcao        String
  situacao      String    @default("ATIVO")
  admissao      DateTime?
  tamanhoBota   Int?
  tamanhoCamisa String?
  tamanhoCalca  Int?
  cpf           String?
  rg            String?
  nascimento    DateTime?
  moradia       String?
  endereco      String?
  numero        String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  contrato      EpiContrato       @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  movimentacoes EpiMovimentacao[]

  @@unique([contratoId, nomeCompleto])
  @@index([contratoId])
  @@index([funcao])
}

// Catalogo de itens (EPI/EPC/fardamento) — nome+tamanho unico, CA quando existir,
// fotoUrl aponta pra /public/epi-fotos (fotos de referencia reais extraidas do
// book de EPI da empresa) ou uma foto enviada depois pelo usuario.
model EpiProduto {
  id            String   @id @default(cuid())
  nome          String
  tipo          EpiTipo  @default(EPI)
  categoria     String?
  ca            String?
  tamanho       String?
  unidade       String   @default("UNID")
  valorUnitario Float?
  // Override do % de contingência do contrato (Métricas), por item — null usa
  // o % do contrato como padrão. Ex.: um item mais crítico pode pedir 20% em
  // vez dos 10% gerais, sem mexer no % de todo mundo.
  percentualContingencia Float?
  fotoUrl       String?
  ativo         Boolean  @default(true)
  createdAt     DateTime @default(now())

  movimentacoes EpiMovimentacao[]
  estoques      EpiEstoque[]

  @@unique([nome, tamanho])
}

model EpiEstoque {
  id             String   @id @default(cuid())
  contratoId     String?
  produtoId      String
  estoqueInicial Int      @default(0)
  estoqueMinimo  Float    @default(0)
  updatedAt      DateTime @updatedAt

  contrato EpiContrato? @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  produto  EpiProduto   @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  @@unique([contratoId, produtoId])
  @@index([produtoId])
}

model EpiMovimentacao {
  id              String           @id @default(cuid())
  data            DateTime         @default(now())
  tipo            EpiMovimentoTipo
  produtoId       String
  contratoId      String
  colaboradorId   String?
  quantidade      Int
  observacao      String?
  registradoPorId String?
  createdAt       DateTime         @default(now())

  produto       EpiProduto      @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  contrato      EpiContrato     @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  colaborador   EpiColaborador? @relation(fields: [colaboradorId], references: [id], onDelete: SetNull)
  registradoPor User?           @relation(fields: [registradoPorId], references: [id], onDelete: SetNull)

  @@index([produtoId, contratoId])
  @@index([colaboradorId])
  @@index([contratoId, data])
}

model EpiFuncaoRegra {
  id         String @id @default(cuid())
  contratoId String
  funcao     String
  categoria  String
  descricao  String @db.Text

  contrato EpiContrato @relation(fields: [contratoId], references: [id], onDelete: Cascade)

  @@unique([contratoId, funcao, categoria])
  @@index([funcao])
}
