generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Usuario de login. Era "sem nivel/hierarquia" (comentario antigo — a ideia
// original era incorporar isso ao sistema de chamados depois), mas o João
// pediu login de verdade pra outras pessoas (Matheus, Samuel, Nilmara) com
// controle de acesso — por isso o `role` abaixo. ADMIN ve tudo, incluindo
// esta tela de cadastro de usuarios; OPERADOR ve o resto do sistema mas nao
// gerencia outros usuarios.
enum UserRole {
  ADMIN
  OPERADOR
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(ADMIN)
  createdAt    DateTime @default(now())

  epiMovimentacoesRegistradas EpiMovimentacao[]
}

enum EpiTipo {
  EPI
  EPC
  FARDAMENTO
  GERAL
}

enum EpiMovimentoTipo {
  ENTRADA
  SAIDA
}

model EpiContrato {
  id                     String   @id @default(cuid())
  codigo                 String   @unique
  nome                   String?
  ativo                  Boolean  @default(true)
  percentualContingencia Float    @default(0.10)
  createdAt              DateTime @default(now())

  colaboradores EpiColaborador[]
  movimentacoes EpiMovimentacao[]
  estoques      EpiEstoque[]
  funcaoRegras  EpiFuncaoRegra[]
}

model EpiColaborador {
  id            String    @id @default(cuid())
  nomeCompleto  String
  contratoId    String
  funcao        String
  situacao      String    @default("ATIVO")
  admissao      DateTime?
  tamanhoBota   Int?
  tamanhoCamisa String?
  tamanhoCalca  Int?
  cpf           String?
  rg            String?
  nascimento    DateTime?
  moradia       String?
  endereco      String?
  numero        String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  contrato        EpiContrato          @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  movimentacoes   EpiMovimentacao[]
  itensNecessarios EpiColaboradorItem[]

  @@unique([contratoId, nomeCompleto])
  @@index([contratoId])
  @@index([funcao])
}

// Tabela real de "quem usa o quê", pedida pelo João (31/08/2026) pra
// substituir o cruzamento por palavra-chave em texto livre feito toda vez
// que a tela carregava (frágil — já rendeu 2 rodadas de bug real: string de
// função não batia por causa de sufixo de nível, e um typo de palavra-chave
// deixou passar um item). Gerada uma vez (endpoint de rebuild) a partir da
// ficha (tamanhoBota/Calca/Camisa) + da matriz EpiFuncaoRegra, e fica
// congelada até rodar o rebuild de novo — dá pra auditar linha por linha
// (colaborador X precisa de item Y, tamanho Z), não é mais caixa-preta.
model EpiColaboradorItem {
  id            String   @id @default(cuid())
  colaboradorId String
  produtoNome   String // nome canônico do EpiProduto (ex.: "BOTA", "CAPACETE BRANCO")
  tamanho       String? // só quando o item tem tamanho na ficha (bota/calça/camisa)
  origem        String // "FICHA" (veio direto do tamanhoBota/Calca/Camisa) ou "FUNCAO" (veio da regra por função)
  createdAt     DateTime @default(now())

  colaborador EpiColaborador @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)

  @@unique([colaboradorId, produtoNome])
  @@index([produtoNome])
}

// Catalogo de itens (EPI/EPC/fardamento) — nome+tamanho unico, CA quando existir,
// fotoUrl aponta pra /public/epi-fotos (fotos de referencia reais extraidas do
// book de EPI da empresa) ou uma foto enviada depois pelo usuario.
model EpiProduto {
  id            String   @id @default(cuid())
  nome          String
  tipo          EpiTipo  @default(EPI)
  categoria     String?
  ca            String?
  fabricante    String?
  tamanho       String?
  // Flag de condição do lote (peça lavada/reaproveitada, controlada à parte
  // do estoque novo) — é metadado do MESMO tipo+tamanho, igual marca/CA, não
  // um tamanho ou produto diferente. Corrigido em 31/08/2026: antes vinha
  // embutido como texto dentro de `tamanho` (ex.: "G (Higienizada)"), o que
  // dobrava a lista de tamanhos por peça e confundia o cadastro.
  higienizado   Boolean  @default(false)
  unidade       String   @default("UNID")
  valorUnitario Float?
  // Override do % de contingência do contrato (Métricas), por item — null usa
  // o % do contrato como padrão. Ex.: um item mais crítico pode pedir 20% em
  // vez dos 10% gerais, sem mexer no % de todo mundo.
  percentualContingencia Float?
  fotoUrl       String?
  // Descrição de referência real (aba "EPI - OP 3", catálogo oficial da
  // empresa com foto/modelo/fabricante) — usada no cadastro de itens como
  // fonte de verdade do que o item é, sem depender de marca/CA.
  descricao     String?  @db.Text
  ativo         Boolean  @default(true)
  createdAt     DateTime @default(now())

  movimentacoes EpiMovimentacao[]
  estoques      EpiEstoque[]

  @@unique([nome, tamanho, higienizado])
}

model EpiEstoque {
  id             String   @id @default(cuid())
  contratoId     String?
  produtoId      String
  estoqueInicial Int      @default(0)
  estoqueMinimo  Float    @default(0)
  updatedAt      DateTime @updatedAt

  contrato EpiContrato? @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  produto  EpiProduto   @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  @@unique([contratoId, produtoId])
  @@index([produtoId])
}

model EpiMovimentacao {
  id              String           @id @default(cuid())
  data            DateTime         @default(now())
  tipo            EpiMovimentoTipo
  produtoId       String
  contratoId      String
  colaboradorId   String?
  quantidade      Int
  observacao      String?
  registradoPorId String?
  createdAt       DateTime         @default(now())

  produto       EpiProduto      @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  contrato      EpiContrato     @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  colaborador   EpiColaborador? @relation(fields: [colaboradorId], references: [id], onDelete: SetNull)
  registradoPor User?           @relation(fields: [registradoPorId], references: [id], onDelete: SetNull)

  @@index([produtoId, contratoId])
  @@index([colaboradorId])
  @@index([contratoId, data])
}

// % de contingência padrão por categoria (Material de Escritório, Itens
// Veicular, Insumos Alojamento, Depósito Geral, ou até EPI/EPC/FARDAMENTO
// direto) — fica ENTRE o % do contrato (mais genérico) e o % do produto
// (mais específico). Ordem de resolução: produto > categoria > contrato.
model EpiCategoriaConfig {
  categoria              String @id
  percentualContingencia Float  @default(0.10)
}

model EpiFuncaoRegra {
  id         String @id @default(cuid())
  contratoId String
  funcao     String
  categoria  String
  descricao  String @db.Text

  contrato EpiContrato @relation(fields: [contratoId], references: [id], onDelete: Cascade)

  @@unique([contratoId, funcao, categoria])
  @@index([funcao])
}
